{
  "name": "veyrqun-gateway",
  "version": "3.0.0",
  "private": true,
  "description": "VEYRQUN inline governance gateway for LLM and MCP traffic",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "mock:llm": "tsx src/mock/llm.ts",
    "mock:mcp": "tsx src/mock/bankcore-mcp.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-policy-agent/opa-wasm": "1.10.0",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "prom-client": "15.1.3",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "packageManager": "npm@10.9.9"
}
