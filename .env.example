# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- control plane ---
VEYRQUN_DB_FILE=control-plane/veyrqun.db
DATABASE_URL=                      # postgresql+psycopg://user:pass@host:5432/veyrqun (Phase 1)
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5173
VEYRQUN_SIMULATOR=1

# --- Supabase (hosted demo) ---
SUPABASE_PROJECT_REF=
