# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- control plane ---
VEYRQUN_ENV=dev                         # dev | test | production (production refuses insecure defaults)
DATABASE_URL=postgresql+psycopg://veyrqun_app:veyrqun_app_dev@localhost:55432/veyrqun          # runtime role
MIGRATION_DATABASE_URL=postgresql+psycopg://veyrqun_owner:veyrqun_owner_dev@localhost:55432/veyrqun  # schema owner
REDIS_URL=redis://localhost:56379/0
ALLOWED_ORIGINS=http://localhost:5173
VEYRQUN_SIMULATOR=1
# Envelope-encryption master keys: comma-separated kid:base64(32 bytes); the first is active. Required in production.
#   python -c "import base64,os; print('k1:' + base64.b64encode(os.urandom(32)).decode())"
VEYRQUN_MASTER_KEY=
# Bearer token gateways present to GET /bundles/current. Required in production.
BUNDLE_SERVICE_TOKEN=
JWT_ISSUER=https://veyrqun.local
# Keyed hash for email lookups (base64 32 bytes). Required in production.
VEYRQUN_LOOKUP_KEY=
METRICS_TOKEN=

# --- operator login (any OIDC provider; Keycloak in docker compose) ---
OIDC_ISSUER=http://localhost:8180/realms/veyrqun
OIDC_CLIENT_ID=veyrqun-dashboard
OIDC_CLIENT_SECRET=dev-dashboard-secret         # = KC_DASHBOARD_CLIENT_SECRET for the compose Keycloak
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
APP_BASE_URL=http://localhost:5173
DEFAULT_WORKSPACE_ENV=production                # production enforces maker-checker on publishes
TURNSTILE_SECRET=                               # enables Cloudflare Turnstile on sandbox signup
KC_DASHBOARD_CLIENT_SECRET=dev-dashboard-secret
AGENT_TOKEN_TTL_S=900

# --- Supabase (hosted demo) ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- hosting ---
RENDER_API_KEY=
GCP_PROJECT=
GCP_REGION=
GKE_CLUSTER=
