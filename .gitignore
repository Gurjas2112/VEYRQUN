*.log
logs/
*.tmp
*.temp

# OS Generated Files & Temp Downloads
.DS_Store
Thumbs.db
*.crdownload

# IDE & Editor Settings
.vscode/
.idea/
*.swp

# Internal Agent & AI Configs
.agents/
.gemini/
.claude/
.codex/

