# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual Environments
venv/
.venv/
env/

# Node & Frontend Dependencies / Build
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Database & Runtime State
*.db
*.sqlite
*.sqlite3
control-plane/governance.db
control-plane/veyrqun.db
*.db-wal
*.db-shm
